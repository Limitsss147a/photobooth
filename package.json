{
  "name": "snapbooth",
  "version": "1.0.0",
  "private": true,
  "description": "SnapBooth — All-in-One Photobooth Software",
  "scripts": {
    "dev:desktop": "pnpm --filter @snapbooth/desktop dev",
    "dev:dashboard": "pnpm --filter @snapbooth/dashboard dev",
    "build:desktop": "pnpm --filter @snapbooth/desktop build",
    "build:dashboard": "pnpm --filter @snapbooth/dashboard build",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "resolutions": {
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0"
  },
  "overrides": {
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0"
  },
  "devDependencies": {
    "vite": "^8.1.4"
  }
}
